{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // `@/…` resolves to `src/…` in rshono's compiler too; this keeps the editor in agreement.
    "paths": { "@/*": ["./src/*"] },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },
  // Without this, tsc also walks the gitignored skill-creator workspaces, whose fixtures are broken on purpose.
  "include": ["src", "cli", "test", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
