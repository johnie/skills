{
  "name": "@johnie/skills",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "content-collections build && pnpm og && concurrently --kill-others --names content,web \"content-collections watch\" \"rshono dev\"",
    "build": "content-collections build && pnpm og && rshono build",
    "og": "tsx scripts/og-images.tsx",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "content-collections build && tsc --noEmit",
    "skills": "tsx cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@rshono/core": "^1.0.0-rc.29",
    "@stricli/core": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.17",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/markdown": "^0.1.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "concurrently": "^10.0.7",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.63.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.18.0"
}
