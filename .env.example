# AI Test Configuration

# Test provider: "lmstudio" (local) or "openrouter" (cloud)
TEST_PROVIDER=lmstudio

# LM Studio Configuration (for local testing)
# Base URL for LM Studio API (default: http://localhost:1234/v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OpenRouter Configuration (for cloud testing)
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Model to use for testing (when using OpenRouter)
# Default: qwen/qwen-2.5-7b-instruct (fast and affordable)
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# Model to use for AI evaluation/judging (when using OpenRouter)
# Default: anthropic/claude-3.5-sonnet (more capable for quality assessment)
OPENROUTER_JUDGE_MODEL=anthropic/claude-3.5-sonnet

# Website (rshono). Only `PUBLIC_`-prefixed variables reach the browser bundle; the rest stay server-only.
# Read once at startup: restart `pnpm dev` after changing it. Defaults to "johnie-skills" when unset.
PUBLIC_APP_NAME=johnie-skills

# GitHub token for the header's star count (`src/lib/github.ts`). Optional: left empty, the call is unauthenticated
# and limited to 60 an hour per IP. Fine-grained, "Public repositories (read-only)", no permissions:
# https://github.com/settings/personal-access-tokens/new?name=skills.johnie.se+stars&target_name=johnie&expires_in=none
# Production reads the Worker secret instead (`pnpm exec wrangler secret put GITHUB_TOKEN`).
GITHUB_TOKEN=
